# IndyKite API Configuration
# Copy this file to .env and fill in your actual values
# Service Account token from https://eu.hub.indykite.com/service-accounts
SA_TOKEN=your_service_account_token_here
# API endpoint URL (use eu or us depending on your region)
URL_ENDPOINTS=https://eu.api.indykite.com
# OR
# URL_ENDPOINTS=https://us.api.indykite.com
# Organization Id - ID attribute available in Organization > Settings
ORGANIZATION_ID=
# Which dataset to provision from, i.e. which data/<DATASET>/ folder is used
# (manifest.json + nodes.json + relationships.json). Defaults to "canbank" when unset.
# Add another dataset by dropping in data/<name>/ and setting DATASET=<name>.
DATASET=canbank
# User bearer token sent as Authorization: Bearer <token> on ContX IQ execute calls.
# Required for policies whose subject is a User and matches on $token.sub
# (e.g. get-self, get-stock-quote, get-stock-trade-threshold, get-internal-documents, get-decisions).
# not necessary if you don't test ciq execute in this app
USER_TOKEN=

# [canbank-ts dataset only] Public signing JWK of the self-hosted token-service
# (iag-token-exchange), substituted into the token-service-https-chatbot-mcp
# token-introspect config via the ${TOKEN_SERVICE_PUBLIC_JWK} manifest
# placeholder. One JWK as a single-line JSON string, stripped to
# kty/n/e/alg/kid/use (the config API rejects the published key_ops). Fetch:
#   curl -s http://localhost:8102/.well-known/jwks.json | python3 -c "
#   import sys, json; k = json.load(sys.stdin)['keys'][0]
#   print(json.dumps({f: k[f] for f in ('kty','n','e','alg','kid','use')}))"
TOKEN_SERVICE_PUBLIC_JWK=

# [intent-ibac dataset only] The six Agent Gateways of a2a/intent-ibac-gateway
# authenticate with Auth0 Machine-to-Machine applications of the same tenant
# as the ibac dataset (AUTH0_ISSUER below). Each gateway's client-credentials
# token has sub <client_id>@clients: that value is the Agent node's external_id
# (${AUTH0_SUB_<AGENT>} in nodes.json and relationships.json). The people's
# access tokens are validated by the auth0-people introspect on that issuer;
# the delegated tokens by TOKEN_SERVICE_PUBLIC_JWK above (the demo's
# `make keys` prints it).
AUTH0_SUB_TRADING_DESK=<client_id>@clients
AUTH0_SUB_SUPPORT_DESK=<client_id>@clients
AUTH0_SUB_BILLING=<client_id>@clients
AUTH0_SUB_PEOPLE_DIRECTORY=<client_id>@clients
AUTH0_SUB_WORKFLOW_RUNNER=<client_id>@clients
# The weather gateway reuses the tenant's Weather application: AUTH0_SUB_WEATHER below, shared with the ibac dataset.

# [ibac dataset only] Auth0 bindings substituted into the dataset at
# provisioning time: the issuer of the auth0-person-introspect config, and the
# subjects of the eight agent machine-to-machine clients, which are the Agent
# nodes' external_ids, the chain-guard filter values and the delegation chain
# the gateways resolve workflows with. An Auth0 client-credentials token has
# sub = <client_id>@clients, so each value is the M2M application's client id
# followed by "@clients".
AUTH0_ISSUER=https://<tenant>.auth0.com/
AUTH0_SUB_ORCHESTRATOR=<client_id>@clients
AUTH0_SUB_RETRIEVER=<client_id>@clients
AUTH0_SUB_WEATHER=<client_id>@clients
AUTH0_SUB_ANALYST=<client_id>@clients
AUTH0_SUB_MCP=<client_id>@clients
AUTH0_SUB_DRIVE=<client_id>@clients
AUTH0_SUB_CRM=<client_id>@clients
AUTH0_SUB_ERP=<client_id>@clients

# Event sink destination (Google Cloud Pub/Sub) for the tamper-proof audit trail.
# Optional: when all three are set, provisioning adds audit signing + the event sink
# right after the App Agent; otherwise both are skipped. Only events the sink
# delivered are chained, so set them before the captures you want to show.
# The key file is a service-account key with roles/pubsub.publisher on the topic;
# it is read when the sink is created and never stored in this file.
PUBSUB_GCP_PROJECT=
PUBSUB_TOPIC=indykite-audit-events
PUBSUB_CREDENTIALS_FILE=~/secrets/ik-event-sink.json
