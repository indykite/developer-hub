# !!!!! IMPORTANT !!!!!
# make sure your Identity Provider client is set up with the correct chatbot redirect URL
# (i.e. http://${CHATBOT_HOST}:${CHATBOT_PORT}/auth/callback)
# and that you are using the correct host in your browser
# (i.e. if the CHATBOT_HOST is localhost, don't connect to 127.0.0.1 and vice versa)

# [Required]
# https://us.api.indykite.com, https://eu.api.indykite.com
INDYKITE_BASE_URL=https://<ENV>.api.indykite.com
# Base URL of the IdP where the console/indykiteagent* clients live. Used by
# the chatbot login AND all gateways (introspection/token exchange) - they
# must be the same instance.
IDP_BASE_URL=<idp-base-url>
# Issuer of that IdP, exactly as it writes it into the `iss` of its tokens.
# The gateways advertise it: OpenID discovery URL on the agent cards, and
# authorization server in the MCP gateways' protected resource metadata.
IDP_ISSUER=https://idsvr.indykite.one/oauth/v2/oauth-anonymous
# [Optional] Agent Gateway image; the default is the published 2.0.3 release
# pinned by digest in iag-base-docker.yaml. Never use the `latest` tag.
#AGENT_GATEWAY_IMAGE=indykite/agent-gateway:2.0.3
# [Optional] Capability checks of the gateways (default true): MCP gateways
# filter tools/resources/prompts to what the caller may use (CAN_USE) and
# refuse the rest with 403 / -31403; A2A gateways filter the skills of the
# extended agent card. false = admission decision only, lists unfiltered.
IAG_CAPABILITY_CHECKS=true
# The Drive gateway is the exception (default false): Drive files are MCP
# resources with one URI per file, which the graph does not model, so with
# the checks on a file read is refused and only the `search` tool passes.
IAG_DRIVE_CAPABILITY_CHECKS=false

# [Required] App agent credentials of the usecase's project: the gateways
# authenticate their whoami and AuthZEN calls with it. Per-usecase value:
# each usecase lives in its own IndyKite project, so fill it from that
# project's provisioning output.
# WORKFLOW_ID is read by the console only (the "why?" cards of the
# orchestrator, retriever and MCP gateways explain this workflow); the
# gateways take no workflow setting - the *-can-reach-agent policy decides.
WORKFLOW_ID=wf1
APP_AGENT_CREDENTIALS_TOKEN=valid.appagent.token
# [canbank subject only] Queries behind the retriever's max-purchase tool;
# the insurance subject disables the tool (MAX_PURCHASE_TOOL_ENABLED=false in
# its usecase.env) and defines no such queries - omit these for insurance.
CIQ_QUERY_STOCK_PRICE=get-stock-quote
CIQ_QUERY_PURCHASE_LIMIT=get-stock-trade-threshold
CIQ_QUERY_STORE_DECISION=store-decision
# [all usecases] Used by weather_agent: when the user asks about
# HQ/headquarters/office, the agent calls the MCP tool of this name - the
# IndyKite MCP server serves every named knowledge query as a tool - which
# reads the hq_weather node and fires the usecase's `weather` and
# `weather-units` external data resolvers. Must be the query's NAME, not its
# gid: the gateway permits the tool by name on the weather workflow (wf2).
CIQ_QUERY_HQ_WEATHER=get-hq-weather
# [all usecases] "Explain the decision": gids of the two explain CIQ queries
# (explain-staff-workflow-access / explain-direct-workflow-access) from the
# usecase's provisioning output. When set, every AUTHORIZED / NOT AUTHORIZED
# audit card gets a "why?" button that renders the live authorization path
# (or its absence) from the graph. Leave empty to hide the feature.
EXPLAIN_STAFF_QUERY_ID=
EXPLAIN_DIRECT_QUERY_ID=

# [Required] MCP configuration
# NOTE: the MCP server resolves the AppAgent identity server-side from the
# project's MCP server configuration (app_agent_id), which is created together
# with the project and configured in the IndyKite console. Callers send only the
# user's Bearer token; the previously-required IK_APP_AGENT_KEY / X-IK-ClientKey
# is no longer used.
# Origin (scheme + host) of the real IndyKite MCP server. The MCP-protecting IAG
# (mcp-iag) forwards to ${MCP_SERVER_ORIGIN}${MCP_SERVER_PATH}.
# Must be the MCP host matching INDYKITE_BASE_URL (e.g.
# https://us.mcp.indykite.com, https://eu.mcp.indykite.com).
MCP_SERVER_ORIGIN=https://<ENV>.mcp.indykite.com
# Path of the MCP endpoint on that server. The compose file appends this to the
# mcp-iag host so the agents call http://mcp-iag:${IAG_MCP_PORT}${MCP_SERVER_PATH}.
# Per-usecase value: the PROJECT_GID is the usecase's own project. Write it
# unencoded (gid:..., not gid%3A...): a gateway does not start with an encoded
# path. Use the same form in MCP_SERVER_URL and ANALYST_MCP_SERVER_URLS.
MCP_SERVER_PATH=/mcp/v1/<PROJECT_GID>
# Direct URL to the real MCP server. By default the compose file routes the
# retriever and weather agents through mcp-iag instead of this value; it is kept
# here for reference / for bypassing the IAG.
MCP_SERVER_URL=https://<ENV>.mcp.indykite.com/mcp/v1/<PROJECT_GID>
# IdP client the mcp-iag uses to authenticate to the downstream MCP server.
MCP_IDP_CLIENT_ID=indykiteagent-mcp
MCP_IDP_CLIENT_SECRET=

# [Required] From your IdP Provider configuration
CHATBOT_IDP_CLIENT_ID=console
CHATBOT_IDP_CLIENT_SECRET=
ORCHESTRATOR_IDP_CLIENT_ID=indykiteagent
ORCHESTRATOR_IDP_CLIENT_SECRET=
RETRIEVER_IDP_CLIENT_ID=indykiteagent-2
RETRIEVER_IDP_CLIENT_SECRET=
WEATHER_IDP_CLIENT_ID=indykiteagent-3
WEATHER_IDP_CLIENT_SECRET=
ANALYST_IDP_CLIENT_ID=indykiteagent-4
ANALYST_IDP_CLIENT_SECRET=
# The *_WORKFLOW_ID values below are read by the console only: the workflow a
# gateway's "why?" card explains (audit records name the delegation chain,
# not a workflow). The gateways take no workflow setting. Empty = the card
# falls back to the grant bundle of that gateway, when there is one.
# The analyst serves several call shapes (wf3 direct, wf3-console, wf-drive-*,
# wf-erp-*), so no single workflow fits its cards.
ANALYST_WORKFLOW_ID=

# The weather agent is wired under wf2 in the graph (orchestrator -> weather
# -> mcp), not the base WORKFLOW_ID (wf1).
WEATHER_WORKFLOW_ID=wf2

# [Optional - insurance usecase] CRM agent (Salesforce cases on behalf of a
# person). IdP client the crm-iag uses, and the staff-only workflow its
# "why?" cards explain (wf-crm: support/sales -> orchestrator -> crm; james
# has no CAN_TRIGGER edge).
CRM_IDP_CLIENT_ID=indykiteagent-crm
CRM_IDP_CLIENT_SECRET=
CRM_WORKFLOW_ID=wf-crm
# Salesforce connected app for the OAuth 2.0 JWT Bearer flow (RFC 7523):
# generate a keypair, upload the certificate to the connected app, enable
# "use digital signatures", pre-authorize the integration user's profile.
# The private key goes in crm_agent/keys/sf-jwt.key (gitignored).
SF_LOGIN_URL=https://login.salesforce.com
SF_CONSUMER_KEY=
SF_USERNAME=
SF_PRIVATE_KEY_FILE=/app/keys/sf-jwt.key
# The console's Salesforce TOKEN card is redacted by default (third-party
# credential); set true to display the full token on stage.
SF_REPORT_FULL_TOKEN=

# [Optional] Compose profiles for the optional service pairs; comma-separated,
# no CLI flag needed - plain `docker compose up` reads it from .env:
#   drive = drive-mcp + drive-mcp-iag (Google Drive MCP PoC)
#   crm   = crm + crm-iag (Salesforce cases; insurance usecase)
#   erp   = erp-db + erp-mcp + erp-mcp-iag (graph-filtered invoices)
# e.g. COMPOSE_PROFILES=drive,crm,erp. Leave empty to run the base demo.
COMPOSE_PROFILES=
# IdP client the drive-mcp-iag uses for its client-credentials/token-exchange
# flow.
DRIVE_MCP_IDP_CLIENT_ID=indykiteagent-drive
DRIVE_MCP_IDP_CLIENT_SECRET=
# The drive gateway serves one workflow per call shape (wf-drive direct,
# wf-drive-analyst, wf-drive-console); its "why?" cards use the grant bundle.
DRIVE_WORKFLOW_ID=
# Deny -> remediate -> allow: DENY cards from these gateways offer a one-click
# CAN_TRIGGER grant of the listed workflow bundle ("gateway=wf:wf:...", comma
# between gateways). The chatbot guards the click with a live AuthZEN
# self-check (the granter must be able to trigger those workflows themselves).
# Map the backend gateways only: analyst-iag fronts both Drive and ERP, so no
# single bundle fits its DENY cards. Leave empty to disable the grant buttons.
GRANT_WORKFLOW_MAP=drive-mcp-iag=wf-drive:wf-drive-analyst:wf-drive-console,erp-mcp-iag=wf-erp:wf-erp-analyst:wf-erp-console

# [Optional - profile erp] ERP invoices behind erp-mcp-iag: a Postgres table
# whose rows are pre-filtered per caller by AuthZEN search/resource before any
# SQL runs. IdP client for the gateway, the workflow of its "why?" cards
# (empty = the grant bundle), and the orchestrator's query_erp gate - set ERP_TOOL_ENABLED=true once the erp
# backend is listed in ANALYST_MCP_SERVER_URLS below.
ERP_MCP_IDP_CLIENT_ID=indykiteagent-erp
ERP_MCP_IDP_CLIENT_SECRET=
ERP_WORKFLOW_ID=
ERP_TOOL_ENABLED=
# Multi-backend analyst: comma-separated alias=url pairs. When set, the analyst
# connects to every listed MCP server (instead of the single MCP_SERVER_URL) and
# prefixes each backend's tool names with its alias (indykite_ciq_execute,
# drive_search, ...). Values are not variable-expanded, so spell out the
# IndyKite gateway path (same as MCP_SERVER_PATH). Example:
ANALYST_MCP_SERVER_URLS=indykite=http://mcp-iag:8886/mcp/v1/<PROJECT_GID>,drive=http://drive-mcp-iag:8887/mcp,erp=http://erp-mcp-iag:8889/mcp
# [Optional] How long (seconds) the analyst reuses each user's MCP sessions
# across requests before rebuilding them (ping-validated on reuse). This skips
# the per-request session setup - the dominant latency cost. Keep it below the
# access-token lifetime; 0 = fresh session per request (old behavior).
MCP_SESSION_TTL=1500


# [Optional] Setup Gemini or local LLM
# Use Gemini instead of local Ollama when true (GEMINI_ENABLED or GEMENI_ENABLED)
GEMINI_ENABLED=true
# When using Ollama from Docker, set to reach host: OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_HOST=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_API_KEY=
LOCAL_LLM_MODEL=qwen3:14b-q8_0

# [Optional] Chatbot setup
# Generate a fresh secret with:
#   docker run --rm python:3.12 python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=CHANGE_ME

# [Optional] Logging
LOG_LEVEL=INFO
# [Optional] Log level for third-party libraries (a2a SDK, mcp, httpx) in the
# agents, independent of LOG_LEVEL. The a2a SDK dumps every full protobuf event
# at DEBUG; keep this at INFO for readable agent logs, or set DEBUG to see the
# SDK events condensed to one-line breadcrumbs.
# DEBUG INFO WARNING (avoid ERROR)
LIB_LOG_LEVEL=WARNING

# [Ignore] Network setup (no need to change unless port conflicts)
CHATBOT_PORT=3000
CHATBOT_HOST=localhost
IAG_ORCHESTRATOR_PORT=8881
IAG_ORCHESTRATOR_HOST=orchestrator-iag
ORCHESTRATOR_PORT=6001
ORCHESTRATOR_HOST=orchestrator
IAG_RETRIEVER_PORT=8882
IAG_RETRIEVER_HOST=retriever-iag
RETRIEVER_PORT=6002
RETRIEVER_HOST=retriever
IAG_WEATHER_PORT=8884
IAG_WEATHER_HOST=weather-iag
WEATHER_PORT=6004
WEATHER_HOST=weather
IAG_ANALYST_PORT=8885
IAG_ANALYST_HOST=analyst-iag
ANALYST_PORT=6005
ANALYST_HOST=analyst
# CRM pair (insurance usecase only): leave IAG_CRM_HOST empty in a usecase
# without a CRM story - the orchestrator then hides the query_crm tool.
IAG_CRM_PORT=8888
IAG_CRM_HOST=crm-iag
CRM_PORT=6006
CRM_HOST=crm
IAG_MCP_PORT=8886
IAG_MCP_HOST=mcp-iag
IAG_DRIVE_MCP_PORT=8887
IAG_DRIVE_MCP_HOST=drive-mcp-iag
DRIVE_MCP_PORT=8000
DRIVE_MCP_HOST=drive-mcp
IAG_ERP_MCP_PORT=8889
ERP_MCP_PORT=8010
ERP_MCP_HOST=erp-mcp

# [Required] Demo usecase bundle (usecases/<name>/): domain vocabulary and
# per-agent skills. See usecases/README.md. Each subject keeps its own
# complete env file (.env.<subject>, gitignored); .env is a symlink to the
# active one - switch with ./switch-usecase.sh <subject>.
USECASE=canbank

# [insurance usecase only] Subject node type the console (grant self-check,
# CAN_TRIGGER edges) and the ERP server (AuthZEN search) use; default User.
# In the insurance dataset every login (staff and the customer james) is a
# Person, so set Person there; canbank logins are User. The gateways do not
# read it: they take the type from whoami, i.e. from the project's token
# introspect configuration.
AUTHZEN_SUBJECT_TYPES=User
