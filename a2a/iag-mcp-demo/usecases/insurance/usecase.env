# SecureHome Insurance usecase bundle - loaded by docker-compose (env_file)
# for every agent when USECASE=insurance. Values here define the demo's
# domain; the agents themselves are usecase-agnostic.
#
# Dataset: instant-stack data/insurance (household-insurance basis - the
# Mitchell family et al. - adapted for the Agent Gateway). Provision it
# before running this usecase; see usecases/insurance/DEMO_SCRIPT.md.

USECASE_NAME=insurance
ORG_NAME=SecureHome Insurance

# Weather agent: which phrases route to the HQ knowledge-query path, and how
# the location is titled when the graph does not supply one. SecureHome HQ
# is in Chicago (the 123 Oak Avenue story).
WEATHER_HQ_KEYWORDS=hq,headquarters,head office,head-office,securehome office,the office
WEATHER_HQ_NAME=SecureHome HQ

# CIQ knowledge-query names, as provisioned in this usecase's dataset:
# get-self, get-home-insurance-access, get-family-overview,
# get-teens-driving-age, get-authorized-drivers, get-policy-documents,
# get-hq-weather, get-my-household. Only the HQ-weather name is read from env by agent code;
# the rest are advertised to the LLM through the ciq-execute skill.
CIQ_QUERY_HQ_WEATHER=get-hq-weather

# The floor(limit/price) composite tool is a trading gimmick; off here.
MAX_PURCHASE_TOOL_ENABLED=false
