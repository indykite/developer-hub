# CanBank usecase bundle of the ibac-demo - loaded by docker-compose
# (env_file) for every agent when USECASE=ibac. Values here define the
# demo's domain; the agents themselves are usecase-agnostic.
#
# Dataset: instant-stack data/ibac - the CanBank graph whose only identities
# are Persons with Auth0 subjects as external_ids (staff, customers and
# their families). Provision it before running; see DEMO_SCRIPT.md.

USECASE_NAME=ibac
ORG_NAME=CanBank
# One-line tagline shown on the console's empty state.
ORG_TAGLINE=Banking agents governed by the knowledge graph
# The console's app layer (sections, action cards, prompts) is in app.json
# next to this file, mounted into the chatbot by docker-compose.

# Weather agent: which phrases route to the HQ knowledge-query path, and how
# the location is titled when the graph does not supply one.
WEATHER_HQ_KEYWORDS=hq,headquarters,head office,head-office,canbank office,the office
WEATHER_HQ_NAME=CanBank HQ

# CIQ knowledge-query names, as provisioned in this usecase's dataset.
CIQ_QUERY_STOCK_PRICE=get-stock-quote
CIQ_QUERY_PURCHASE_LIMIT=get-stock-trade-threshold
CIQ_QUERY_STORE_DECISION=store-decision
CIQ_QUERY_HQ_WEATHER=get-hq-weather

# Retriever composite tool: floor(purchase limit / unit price), for the
# trading desk (customer id + ticker).
MAX_PURCHASE_TOOL_ENABLED=true
