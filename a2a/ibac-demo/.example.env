# !!!!! IMPORTANT !!!!!
# make sure the Auth0 console application lists the chatbot callback URL
# (i.e. http://${CHATBOT_HOST}:${CHATBOT_PORT}/auth/callback) and logout URL
# (http://${CHATBOT_HOST}:${CHATBOT_PORT}/), and that you are using the correct
# host in your browser (i.e. if the CHATBOT_HOST is localhost, don't connect to
# 127.0.0.1 and vice versa)

# [Required]
# https://us.api.indykite.com, https://eu.api.indykite.com
INDYKITE_BASE_URL=https://<ENV>.api.indykite.com

# [Required] Agent Gateway image, pulled from Docker Hub.
AGENT_GATEWAY_IMAGE=indykite/agent-gateway:2.0.3
# [Required] Token Service image, pulled from Docker Hub. When you name a
# locally loaded gateway image above, name a Token Service of the same
# release here: the gateway sends the intent to the Token Service, which has
# to write it into the token.
TOKEN_SERVICE_IMAGE=indykite/token-service:1.0.0
# [Optional] Capability checks of the gateways (on by default): the
# MCP gateways list and allow only the tools, resources and prompts the
# dataset attaches to the agent for the workflow of the call (HAS edges and
# the person-can-use-* policies), and the A2A gateways filter the skills of
# the extended agent card. false restores the pass-through behaviour of the
# earlier releases.
IAG_CAPABILITY_CHECKS=true
# drive-mcp-iag alone runs without them by default: the Drive server serves
# every file as an MCP resource (gdrive:///<fileId>), ids that cannot be put
# in the graph in advance, so file reads would be refused. Admission still
# decides who reaches Drive. true = only the modelled `search` tool passes.
IAG_DRIVE_CAPABILITY_CHECKS=false

# [Required] Auth0 tenant: the people (Person nodes, external_id = the
# token sub) and the agents (machine-to-machine applications) live there.
# The console logs in at the tenant; the gateways reach it through the
# auth0-bridge service (Auth0 has no RFC 7662 introspection endpoint).
AUTH0_DOMAIN=1st.eu.auth0.com
# Identifiers of the three Auth0 APIs. ibac-console is the audience the
# console requests for the user's access token and the one every
# delegation is minted for - the dataset's Token Introspects accept exactly
# this audience. ibac-agents is the audience of the gateways' actor tokens
# (the bridge adds it when a grant names none). intent_agent is what the
# orchestrator gateway asks for before calling the Intent Agent. Each
# gateway's M2M application must be authorized for ibac-agents and
# intent_agent.
AUTH0_CONSOLE_AUDIENCE=ibac-console
AUTH0_AGENTS_AUDIENCE=ibac-agents
INTENT_AGENT_AUDIENCE=intent_agent

# [Required] App agent credentials token of the ibac project (instant-stack
# provisioning output APP_TOKEN): the gateways resolve every caller with it
# (ContX IQ whoami) and evaluate admission (AuthZEN), the console runs the
# explain queries and grants, the ERP searches invoices, the Intent Agent
# reads schema and policies.
APP_AGENT_CREDENTIALS_TOKEN=valid.appagent.token
# Workflow names the console's why? cards explain per gateway (the staff and
# direct explain queries take a workflow id; the gateways themselves pin no
# workflow: the admission policy decides from the delegation chain).
WORKFLOW_ID=wf1
# [canbank subject only] Queries behind the retriever's max-purchase tool;
# the insurance subject disables the tool (MAX_PURCHASE_TOOL_ENABLED=false in
# its usecase.env) and defines no such queries - omit these for insurance.
CIQ_QUERY_STOCK_PRICE=get-stock-quote
CIQ_QUERY_PURCHASE_LIMIT=get-stock-trade-threshold
CIQ_QUERY_STORE_DECISION=store-decision
# [all usecases] Used by weather_agent: when the user asks about
# HQ/headquarters/office, the agent calls ciq_execute against this query,
# which reads the hq_weather node and fires the subject's `weather` and
# `weather-units` external data resolvers.
CIQ_QUERY_HQ_WEATHER=get-hq-weather
# [all usecases] "Explain the decision": gids of the two explain CIQ queries
# (explain-staff-workflow-access / explain-direct-workflow-access) from the
# usecase's provisioning output. When set, every AUTHORIZED / NOT AUTHORIZED
# audit card gets a "why?" button that renders the live authorization path
# (or its absence) from the graph. Leave empty to hide the feature.
EXPLAIN_STAFF_QUERY_ID=
EXPLAIN_DIRECT_QUERY_ID=

# [Required] MCP configuration
# NOTE: the MCP server resolves the AppAgent identity server-side from the
# project's MCP server configuration (app_agent_id), which is created together
# with the project and configured in the IndyKite console. Callers send only the
# user's Bearer token; the previously-required IK_APP_AGENT_KEY / X-IK-ClientKey
# is no longer used.
# Origin (scheme + host) of the real IndyKite MCP server. The MCP-protecting IAG
# (mcp-iag) uses this as its downstream target; the request path is taken from
# the incoming call, so only the origin is needed here.
# Must be the MCP host matching INDYKITE_BASE_URL (e.g.
# https://us.mcp.indykite.com, https://eu.mcp.indykite.com).
MCP_SERVER_ORIGIN=https://<ENV>.mcp.indykite.com
# Path of the MCP endpoint, UNENCODED (gid:..., not gid%3A...): the gateway
# serves exactly this path (service.base_url) and forwards it to the same
# path on the MCP server; the agents call http://mcp-iag:${IAG_MCP_PORT}${MCP_SERVER_PATH}.
MCP_SERVER_PATH=/mcp/v1/gid:<PROJECT_GID>
# Direct URL to the real MCP server. By default the compose file routes the
# retriever and weather agents through mcp-iag instead of this value; it is kept
# here for reference / for bypassing the IAG.
MCP_SERVER_URL=https://<ENV>.mcp.indykite.com/mcp/v1/gid:<PROJECT_GID>
# Auth0 M2M application of the mcp-iag gateway (its actor identity on the
# MCP hop).
MCP_IDP_CLIENT_ID=
MCP_IDP_CLIENT_SECRET=

# [Required] Auth0 applications. The console is a Regular Web Application
# (authorization code + PKCE); every gateway has its own Machine-to-Machine
# application, whose client id followed by "@clients" is the agent's
# subject in the delegation chain and the Agent node's external_id in the
# graph (AUTH0_SUB_<AGENT> in instant-stack .env).
CHATBOT_IDP_CLIENT_ID=
CHATBOT_IDP_CLIENT_SECRET=
ORCHESTRATOR_IDP_CLIENT_ID=
ORCHESTRATOR_IDP_CLIENT_SECRET=
RETRIEVER_IDP_CLIENT_ID=
RETRIEVER_IDP_CLIENT_SECRET=
WEATHER_IDP_CLIENT_ID=
WEATHER_IDP_CLIENT_SECRET=
ANALYST_IDP_CLIENT_ID=
ANALYST_IDP_CLIENT_SECRET=
# Workflows the console's why? cards explain for the analyst and weather
# gateways (console hints only; empty = the console falls back to the grant
# map). The weather agent is wired under wf2 in the graph.
ANALYST_WORKFLOW_ID=
WEATHER_WORKFLOW_ID=wf2

# [Optional - profile crm] CRM agent (Salesforce cases on behalf of a
# person). Auth0 M2M application of the crm-iag gateway, and the staff-only
# workflow its why? cards explain (wf-crm: support/trading -> orchestrator -> crm).
CRM_IDP_CLIENT_ID=
CRM_IDP_CLIENT_SECRET=
CRM_WORKFLOW_ID=wf-crm
# Salesforce connected app for the OAuth 2.0 JWT Bearer flow (RFC 7523):
# generate a keypair, upload the certificate to the connected app, enable
# "use digital signatures", pre-authorize the integration user's profile.
# The private key goes in crm_agent/keys/sf-jwt.key (gitignored).
SF_LOGIN_URL=https://login.salesforce.com
SF_CONSUMER_KEY=
SF_USERNAME=
SF_PRIVATE_KEY_FILE=/app/keys/sf-jwt.key
# The console's Salesforce TOKEN card is redacted by default (third-party
# credential); set true to display the full token on stage.
SF_REPORT_FULL_TOKEN=

# [Optional] Compose profiles for the optional service pairs; comma-separated,
# no CLI flag needed - plain `docker compose up` reads it from .env:
#   drive = drive-mcp + drive-mcp-iag (Google Drive MCP PoC)
#   crm   = crm + crm-iag (Salesforce cases filed by staff)
#   erp   = erp-db + erp-mcp + erp-mcp-iag (graph-filtered invoices)
#   intent = intent-agent + intent-redis (the Intent Agent behind the
#            orchestrator gateway; also set IBAC_ENABLED=true below)
# e.g. COMPOSE_PROFILES=drive,crm,erp,intent. Leave empty to run the base demo.
COMPOSE_PROFILES=
# Auth0 M2M application of the drive-mcp-iag gateway, and the workflow its
# why? cards explain (empty = the console uses the grant map's last bundle
# entry; the gateway admits every shape whose chain matches a workflow).
DRIVE_MCP_IDP_CLIENT_ID=
DRIVE_MCP_IDP_CLIENT_SECRET=
DRIVE_WORKFLOW_ID=
# Deny -> remediate -> allow: DENY cards from these gateways offer a one-click
# CAN_TRIGGER grant of the listed workflow bundle ("gateway=wf:wf:...", comma
# between gateways). The chatbot guards the click with a live AuthZEN
# self-check (the granter must be able to trigger those workflows themselves).
# Map the backend gateways only: analyst-iag fronts both Drive and ERP, so no
# single bundle fits its DENY cards. Leave empty to disable the grant buttons.
GRANT_WORKFLOW_MAP=drive-mcp-iag=wf-drive:wf-drive-analyst:wf-drive-console,erp-mcp-iag=wf-erp:wf-erp-analyst:wf-erp-console

# [Optional - profile erp] ERP invoices behind erp-mcp-iag: a Postgres table
# whose rows are pre-filtered per caller by AuthZEN search/resource before any
# SQL runs. IdP client for the gateway, the workflow its why? cards explain
# (empty = grant map), and the orchestrator's query_erp gate - set
# ERP_TOOL_ENABLED=true once the erp
# backend is listed in ANALYST_MCP_SERVER_URLS below. The client is the erp
# gateway's Auth0 M2M application.
ERP_MCP_IDP_CLIENT_ID=
ERP_MCP_IDP_CLIENT_SECRET=
ERP_WORKFLOW_ID=
ERP_TOOL_ENABLED=
# Multi-backend analyst: comma-separated alias=url pairs. When set, the analyst
# connects to every listed MCP server (instead of the single MCP_SERVER_URL) and
# prefixes each backend's tool names with its alias (indykite_ciq_execute,
# drive_search, ...). Values are not variable-expanded, so spell out the
# IndyKite gateway path (same as MCP_SERVER_PATH). Example:
ANALYST_MCP_SERVER_URLS=indykite=http://mcp-iag:9886/mcp/v1/gid:<PROJECT_GID>,drive=http://drive-mcp-iag:9887/mcp,erp=http://erp-mcp-iag:9889/mcp
# [Optional] How long (seconds) the analyst reuses each user's MCP sessions
# across requests before rebuilding them (ping-validated on reuse). This skips
# the per-request session setup - the dominant latency cost. Keep it below the
# access-token lifetime; 0 = fresh session per request (old behavior).
MCP_SESSION_TTL=1500


# [Optional] Setup Gemini or local LLM
# Use Gemini instead of local Ollama when true (GEMINI_ENABLED or GEMENI_ENABLED)
GEMINI_ENABLED=true
# When using Ollama from Docker, set to reach host: OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_HOST=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
GEMINI_API_KEY=
LOCAL_LLM_MODEL=qwen3:14b-q8_0

# [Optional] Chatbot setup
# Generate a fresh secret with:
#   docker run --rm python:3.12 python -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=CHANGE_ME

# [Optional] Logging
LOG_LEVEL=INFO
# [Optional] Log level for third-party libraries (a2a SDK, mcp, httpx) in the
# agents, independent of LOG_LEVEL. The a2a SDK dumps every full protobuf event
# at DEBUG; keep this at INFO for readable agent logs, or set DEBUG to see the
# SDK events condensed to one-line breadcrumbs.
# DEBUG INFO WARNING (avoid ERROR)
LIB_LOG_LEVEL=WARNING

# [Ignore] Network setup (no need to change unless port conflicts). The map
# is disjoint from iag-token-exchange / iag-mcp-demo (3000, 6001-6006, 8102,
# 8881-8889, 8000) and intent-agent-demo (3200), so the demos run side by side.
# A gateway's or agent's port is both its host port and its in-network port.
# The console is the exception: CHATBOT_PORT is its host port (and the port
# of the login redirect URLs); inside the network it always listens on 3300,
# where audit-config.yaml and the agents' webhooks post.
CHATBOT_PORT=3300
CHATBOT_HOST=localhost
IAG_ORCHESTRATOR_PORT=9881
IAG_ORCHESTRATOR_HOST=orchestrator-iag
ORCHESTRATOR_PORT=7001
ORCHESTRATOR_HOST=orchestrator
IAG_RETRIEVER_PORT=9882
IAG_RETRIEVER_HOST=retriever-iag
RETRIEVER_PORT=7002
RETRIEVER_HOST=retriever
IAG_WEATHER_PORT=9884
IAG_WEATHER_HOST=weather-iag
WEATHER_PORT=7004
WEATHER_HOST=weather
IAG_ANALYST_PORT=9885
IAG_ANALYST_HOST=analyst-iag
ANALYST_PORT=7005
ANALYST_HOST=analyst
# CRM pair: leave IAG_CRM_HOST empty to hide the orchestrator's query_crm tool.
IAG_CRM_PORT=9888
IAG_CRM_HOST=crm-iag
CRM_PORT=7006
CRM_HOST=crm
IAG_MCP_PORT=9886
IAG_MCP_HOST=mcp-iag
IAG_DRIVE_MCP_PORT=9887
IAG_DRIVE_MCP_HOST=drive-mcp-iag
# Host port of the Drive MCP server (in-network it stays 8000).
DRIVE_MCP_PORT=9000
DRIVE_MCP_HOST=drive-mcp
IAG_ERP_MCP_PORT=9889
ERP_MCP_PORT=8010
ERP_MCP_HOST=erp-mcp

# [Required] Demo usecase bundle (usecases/<name>/): domain vocabulary,
# console app layer and per-agent skills. See usecases/README.md.
USECASE=ibac

# Subject node type the console (grant self-check) and the ERP
# (search/resource) evaluate; the gateways take it from whoami. Every login
# of the ibac dataset is a Person.
AUTHZEN_SUBJECT_TYPES=Person

# [Required] Token Service - the self-hosted issuer of exchanged (delegation)
# tokens; see token-service/README.md. Every gateway exchanges here
# (JARVIS_TOKEN_SERVICE_* in iag-base-docker.yaml): the user's
# token stays in Authorization, the delegation travels in X-IK-Token and
# nests hop by hop (policies read it as $ik_token). Client credentials must
# match token-service.yaml idp.client_auth. The platform trusts the service's
# tokens through the Token Introspect configs the ibac dataset provisions
# (instant-stack data/ibac).
TOKEN_SERVICE_CLIENT_ID=agent-gateway
TOKEN_SERVICE_CLIENT_SECRET=
# Host port of the Token Service (in-network it stays 8102).
TOKEN_SERVICE_PORT=9102
# Base URL as the gateways reach it (defaults to http://token-service:8102
# in iag-base-docker.yaml; set only to override the address).
# TOKEN_SERVICE_BASE_URL=http://token-service:8102

# [Optional - profile intent] Intent-Based Access Control with the IndyKite
# Intent Agent. With IBAC_ENABLED=true and the profile on, the orchestrator
# gateway asks the agent what each prompt means (AuthZEN-shaped evaluations
# drawn from this project's data schema and the caller's Person policies)
# before forwarding it: an intent lets the prompt through, a prompt without
# one is answered by the gateway itself with the agent's error and
# obligation, an unreachable agent is a 502 and a timeout a 504. Every call
# is an INTENT audit record (INTENT_FOUND / INTENT_FAILED, duration, and the
# prompt because audit-config.yaml sets include_prompt). false = the agent
# is never asked and the profile can stay off. The image is the published
# indykite/intent-agent from Docker Hub; point INTENT_AGENT_IMAGE at a local
# build only to test a change to the agent itself
# (make intent-agent-image INTENT_AGENT_SRC=/path/to/intent-agent builds the
# public repo as intent-agent:local).
# The agent introspects the gateway's bearer at the auth0-bridge with an
# M2M client of the tenant - the orchestrator's unless INTENT_INTROSPECT_*
# name another one. Its Gemini key is the GEMINI_API_KEY above.
# Keep it off for the regular acts: on, the orchestrator gateway forwards a
# prompt only when the Intent Agent maps it onto a policy, and prompts outside
# the policy vocabulary (greetings, web search, Drive) are refused in its
# place. Switch it on for the intent beat of the demo script, then off again.
IBAC_ENABLED=false
INTENT_AGENT_BASE_URL=http://intent-agent:6003
INTENT_AGENT_IMAGE=docker.io/indykite/intent-agent:1.1.0
# Above the agent's own per-request limit (REQUEST_TIMEOUT_SECONDS).
INTENT_AGENT_TIMEOUT=45s
INTENT_GEMINI_MODEL=gemini-3.5-flash-lite
# How long the Intent Agent keeps the policy list and the data schema before
# reading them again, in minutes (fractions allowed): a policy or node type
# added to the dataset is visible to the intents after at most this long.
# 0.5 = 30 seconds; the agent's own default is 5.
INTENT_REFRESH_TTL_MINUTES=0.5
INTENT_INTROSPECT_CLIENT_ID=
INTENT_INTROSPECT_CLIENT_SECRET=
INTENT_LOG_LEVEL=INFO
