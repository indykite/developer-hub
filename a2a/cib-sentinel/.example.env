# cib-sentinel - copy to .env and fill in. Nothing here is a secret until you do.

# ---------------------------------------------------------------- IndyKite
# The project provisioned from instant-stack with DATASET=cib.
INDYKITE_BASE_URL=https://<ENV>.api.indykite.com
# App agent credentials of that project (instant-stack prints them).
APP_AGENT_CREDENTIALS_TOKEN=valid.appagent.token
# The project's MCP server (instant-stack: MCP server page).
MCP_SERVER_ORIGIN=https://<ENV>.mcp.indykite.com
MCP_SERVER_PATH=/mcp/v1/gid:<PROJECT_GID>
# Optional: ids of the knowledge queries board-restrictions and board-holds.
# With both set, the console reads back from the graph what the Sentinel
# wrote and draws it on the wall; without them the wall shows the provisioned
# graph and what the feed wrote.
BOARD_RESTRICTIONS_QUERY_ID=
BOARD_HOLDS_QUERY_ID=

# ------------------------------------------------------------------ images
# Published images. To run a locally loaded release, name its tag here.
AGENT_GATEWAY_IMAGE=indykite/agent-gateway:2.0.3
TOKEN_SERVICE_IMAGE=indykite/token-service:1.0.0
IAG_CAPABILITY_CHECKS=true
IAG_AUTHZEN_CACHE_TTL=30s

# ------------------------------------------------------------------- Auth0
AUTH0_DOMAIN=<tenant>.auth0.com
# API the autonomous agent's token is issued for. Its client-credentials
# token with this audience is what the gateways admit at the first hop and
# what the platform resolves to an Agent node.
AUTH0_AUTONOMOUS_AUDIENCE=cib-autonomous
# API the gateways' actor tokens are issued for (the fleet's M2M apps).
AUTH0_AGENTS_AUDIENCE=ibac-agents
# The Sentinel: a Machine to Machine application authorized for the
# AUTH0_AUTONOMOUS_AUDIENCE API. <client_id>@clients is AUTH0_SUB_SENTINEL in
# instant-stack's .env.
SENTINEL_IDP_CLIENT_ID=
SENTINEL_IDP_CLIENT_SECRET=
# The fleet: one Machine to Machine application per gateway, authorized for
# the AUTH0_AGENTS_AUDIENCE API. The ibac-demo applications can be reused;
# <client_id>@clients are AUTH0_SUB_ORCHESTRATOR / _RETRIEVER / _ANALYST /
# _MCP in instant-stack's .env.
ORCHESTRATOR_IDP_CLIENT_ID=
ORCHESTRATOR_IDP_CLIENT_SECRET=
RETRIEVER_IDP_CLIENT_ID=
RETRIEVER_IDP_CLIENT_SECRET=
ANALYST_IDP_CLIENT_ID=
ANALYST_IDP_CLIENT_SECRET=
MCP_IDP_CLIENT_ID=
MCP_IDP_CLIENT_SECRET=

# ----------------------------------------------------------- Token Service
# Must equal idp.client_auth in token-service/token-service.yaml.
TOKEN_SERVICE_CLIENT_ID=agent-gateway
TOKEN_SERVICE_CLIENT_SECRET=
TOKEN_SERVICE_PORT=9202
# Host user id that owns token-service/token-service.yaml (`id -u`); the file
# is readable by its owner only and the Token Service runs as that user.
TOKEN_SERVICE_RUN_AS=1000

# ------------------------------------------------- the wire (Google Pub/Sub)
# The subscription the Sentinel pulls: a pull subscription on the topic the
# project's event sink publishes to (PUBSUB_TOPIC in instant-stack's .env).
# Leave PUBSUB_SUBSCRIPTION empty to run without Pub/Sub: the console then
# hands each fed event to the Sentinel directly, and the wire shows only those.
PUBSUB_GCP_PROJECT=
PUBSUB_SUBSCRIPTION=
# Service-account key with roles/pubsub.subscriber on that subscription.
PUBSUB_SUBSCRIBER_KEY_FILE=
# Host user id that can read the key file (`id -u`).
SENTINEL_RUN_AS=1000

# ------------------------------------------------------------ the Sentinel
# How often it wakes and pulls the subscription, in seconds.
SENTINEL_POLL_SECONDS=20
# llm: a model decides each next task from the brief, the event and what
# happened so far. scripted: the written procedure of usecases/cib/mission.json
# step by step (no model call by the Sentinel; the fleet still uses its own).
SENTINEL_PLANNER=llm
# Pause between two tasks, to stay inside a model's request-per-minute quota.
SENTINEL_STEP_PAUSE_SECONDS=3
SENTINEL_MAX_STEPS=6

# ------------------------------------------------------- intent (optional)
# COMPOSE_PROFILES=intent starts the Intent Agent; IBAC_ENABLED=true makes the
# orchestrator's gateway ask it what each task intends. The gateway then
# carries the intent in the delegation token; a task with no readable intent
# is not passed on. Needs the Auth0 API intent_agent, with the orchestrator
# gateway's application authorized for it.
# The two published images named above ask the Intent Agent but do not carry
# the intent in the token: for the Intent block of the mission cards, name in
# AGENT_GATEWAY_IMAGE and TOKEN_SERVICE_IMAGE a pair that does.
COMPOSE_PROFILES=
IBAC_ENABLED=false
# What the MCP gateway does with a tool that publishes no mapping: allow lets
# it through unchecked by the intent, deny refuses it. The lookups of the
# dataset carry no mapping, so deny leaves the Sentinel only its two writes.
IBAC_UNMAPPED=allow
INTENT_AGENT_AUDIENCE=intent_agent
# The application the Intent Agent checks its callers' tokens with at the
# bridge; the orchestrator gateway's when left empty.
INTENT_INTROSPECT_CLIENT_ID=
INTENT_INTROSPECT_CLIENT_SECRET=
# Model of the Intent Agent; GEMINI_MODEL when left empty.
INTENT_GEMINI_MODEL=
# How long the Intent Agent may take to read one task: per model call, for the
# whole task, and how often an answer that fails its own validation is tried
# again. "The model did not respond in time" means these are too tight.
INTENT_LLM_TIMEOUT_SECONDS=8.0
INTENT_REQUEST_TIMEOUT_SECONDS=25.0
INTENT_VALIDATION_MAX_RETRIES=2

# --------------------------------------------------------------------- LLM
# Shared by the Sentinel and the fleet agents. Gemini when a key is set and
# GEMINI_ENABLED is not false; otherwise Ollama at OLLAMA_HOST.
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite-preview
OLLAMA_HOST=
LOCAL_LLM_MODEL=qwen3:14b-q8_0

# ------------------------------------------------------------------- stack
USECASE=cib
CONSOLE_PORT=3300
MCP_SESSION_TTL=300
LOG_LEVEL=INFO
LIB_LOG_LEVEL=WARNING
