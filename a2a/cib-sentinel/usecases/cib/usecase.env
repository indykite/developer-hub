# Meridian CIB usecase bundle of the cib-sentinel app - loaded by docker-compose
# (env_file) for every agent and the console. Values here define the demo's
# domain; the agents themselves are usecase-agnostic.
#
# Dataset: instant-stack data/cib - a corporate and investment banking graph
# whose only identities are agents. Provision it before running.

USECASE_NAME=cib
ORG_NAME=Meridian
ORG_TAGLINE=An autonomous control room, governed by the knowledge graph

# The retriever's composite stock tool belongs to another dataset.
MAX_PURCHASE_TOOL_ENABLED=false
