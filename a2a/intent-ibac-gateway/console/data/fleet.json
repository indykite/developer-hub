{
  "_comment": "The fleet: the agent cards the IBAC engine matches every intent against. Each is an A2A agent card whose skills carry x-coaz-mappings in the vocabulary of the instant-stack data/intent project: subject types User and Customer, the KBAC actions of its 24 policies, the resource types they grant. Subject ids are the reference $token.sub, resolved from the delegation token's sub (the persona); resource ids are literal where a skill is bound to one resource, a $parameters.<name> reference where the intent carries that parameter, and empty otherwise, which matches as a search. None of these agents runs: the cards are what a gateway in front of each would read. Three policy actions are left unmapped on purpose (User CAN_DISCLOSE Document, User AFFECTED Account, Customer VIEW_PRODUCT_DOCUMENT), and the weather agent publishes no mappings at all.",
  "agents": [
    {
      "id": "trading-desk",
      "accent": "orange",
      "card": {
        "name": "Trading Desk Agent",
        "description": "Quotes and core-banking lookups for the Trading department.",
        "version": "1.4.0",
        "provider": {
          "organization": "CanBank",
          "url": "https://canbank.example"
        },
        "supportedInterfaces": [
          {
            "url": "http://trading-desk:8010/",
            "protocolBinding": "JSONRPC",
            "protocolVersion": "1.0"
          }
        ],
        "capabilities": {
          "streaming": false
        },
        "defaultInputModes": [
          "text/plain"
        ],
        "defaultOutputModes": [
          "application/json"
        ],
        "skills": [
          {
            "id": "quote-lookup",
            "name": "Quote lookup",
            "description": "Retrieve the CANB stock quote and read its price.",
            "tags": [
              "quotes",
              "trading"
            ],
            "examples": [
              "Can I retrieve the quote stock_quote?",
              "What is the price of the quote stock_quote?"
            ],
            "x-coaz-mappings": [
              {
                "subject": [
                  {
                    "type": "Person",
                    "id": "$token.sub"
                  }
                ],
                "resource": [
                  {
                    "type": "Quote",
                    "id": "stock_quote"
                  }
                ],
                "action": [
                  {
                    "name": "CAN_RETRIEVE"
                  },
                  {
                    "name": "GET_PRICE"
                  }
                ]
              }
            ]
          },
          {
