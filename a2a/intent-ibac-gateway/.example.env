# intent-ibac-gateway - copy to .env and fill in the blanks.
# .env is gitignored: it holds the Gemini key, the app agent credential and
# the demo's own secrets. Nothing here is read by git or the images at build time.

# ---------------------------------------------------------------------------
# [Required] IndyKite platform - the project provisioned from
# instant-stack data/intent (its data schema and KBAC policies are the Intent
# Agent's whole vocabulary, and the vocabulary of the fleet's x-coaz-mappings).
# https://eu.api.indykite.com or https://us.api.indykite.com
INDYKITE_BASE_URL=https://<REGION>.api.indykite.com
# App agent credential token of that project (instant-stack provisioning
# output APP_TOKEN). One value, two consumers: the Intent Agent sends it as
# X-IK-ClientKey for /data-schema/v1 and /access/v1/policies; the console
# sends it for AuthZEN decisions and the vocabulary page.
APP_AGENT_CREDENTIALS_TOKEN=

# [Required] Google Gemini API key - the Intent Agent's extraction model.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# ---------------------------------------------------------------------------
# [Required] Auth0 tenant - the identity provider of the people and the agents,
# the same tenant and APIs as a2a/ibac-demo. The gateways and the Intent Agent
# reach it through the auth0-bridge service (Auth0 has no RFC 7662 endpoint).
#   APIs: ibac-people (the people's access tokens), ibac-agents (the gateways'
#   own tokens), intent_agent (the token a gateway presents to the Intent Agent).
#   Applications: one Machine-to-Machine application per gateway, authorized
#   for ibac-agents and intent_agent (the weather gateway reuses the tenant's
#   existing "Weather" application); one M2M application for the Intent
#   Agent's introspection; the existing "Console" Regular Web Application for
#   the login (callback http://localhost:3300/auth/callback; set
#   CONSOLE_PUBLIC_URL when the console is reached at another address).
AUTH0_DOMAIN=<tenant>.eu.auth0.com
AUTH0_PEOPLE_AUDIENCE=ibac-people
AUTH0_AGENTS_AUDIENCE=ibac-agents
# The six gateways' M2M clients. A client-credentials token has sub
# <client_id>@clients: that value is the Agent node's external_id in the graph
# (AUTH0_SUB_<AGENT> in instant-stack's .env) and the agent's name in every chain.
TRADING_DESK_IDP_CLIENT_ID=
TRADING_DESK_IDP_CLIENT_SECRET=
SUPPORT_DESK_IDP_CLIENT_ID=
SUPPORT_DESK_IDP_CLIENT_SECRET=
BILLING_IDP_CLIENT_ID=
BILLING_IDP_CLIENT_SECRET=
PEOPLE_DIRECTORY_IDP_CLIENT_ID=
PEOPLE_DIRECTORY_IDP_CLIENT_SECRET=
WORKFLOW_RUNNER_IDP_CLIENT_ID=
WORKFLOW_RUNNER_IDP_CLIENT_SECRET=
# The tenant's "Weather" application, shared with a2a/ibac-demo.
WEATHER_IDP_CLIENT_ID=
WEATHER_IDP_CLIENT_SECRET=
# The Intent Agent's own M2M client, used to introspect the gateways' bearers at the bridge.
INTENT_INTROSPECT_CLIENT_ID=
INTENT_INTROSPECT_CLIENT_SECRET=
# The "Console" application: the login of the web console (authorization code + PKCE).
CONSOLE_IDP_CLIENT_ID=
CONSOLE_IDP_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# [Required] Generated by `make keys` (writes token-service/token-service.yaml
# and audit-config.yaml, and prints the two values below).
# Secret every gateway presents to the Token Service as client_secret_basic;
# must equal idp.client_auth in token-service.yaml.
TOKEN_SERVICE_CLIENT_SECRET=
# API key the Intent Agent, the Token Service and the six gateways send in
# X-API-Key when they deliver audit records to the console's webhook.
AUDIT_WEBHOOK_API_KEY=

# ---------------------------------------------------------------------------
# [Required] Agent Gateway image. Loaded locally and never pulled: load the
# release (2.99 or later) and tag it agent-gateway:latest, or name it here.
AGENT_GATEWAY_IMAGE=agent-gateway:latest
IAG_LOG_LEVEL=info
# How long a gateway keeps an admission decision before asking the platform again.
IAG_AUTHZEN_CACHE_TTL=30s
# Above the Intent Agent's own per-request limit, so a slow prompt is answered
# by the agent rather than cut off by the gateway.
INTENT_AGENT_TIMEOUT=45s

# ---------------------------------------------------------------------------
# [Optional] Intent Agent image: the published one from Docker Hub. Point it at
# a local build only when testing a change to the agent itself:
#   make intent-agent-image INTENT_AGENT_SRC=/path/to/intent-agent
# builds the public repo (https://github.com/indykite/intent-agent) as
# intent-agent:local.
INTENT_AGENT_IMAGE=docker.io/indykite/intent-agent:1.1.0
# Tuning passed straight through to the agent (see its README for the rest).
INTENT_LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=10.0
LLM_TIMEOUT_SECONDS=3.0
VALIDATION_MAX_RETRIES=1

# [Optional] Console. Published on loopback by default because its API has no
# caller authentication; set CONSOLE_BIND=0.0.0.0 to reach it from another device.
# 3300 is the callback port registered on the tenant's "Console" application
# (shared with a2a/ibac-demo, so the two stacks do not run at the same time).
CONSOLE_PORT=3300
CONSOLE_BIND=127.0.0.1
CONSOLE_LOG_LEVEL=INFO
# Compose profile "cluster" adds a second Intent Agent instance behind an nginx
# balancer to show the shared Redis schema cache. Set both lines together:
#   COMPOSE_PROFILES=cluster
#   INTENT_AGENT_ENTRY=intent-balancer
COMPOSE_PROFILES=
INTENT_AGENT_ENTRY=intent-agent

# [Ignore] Network layout inside the compose project. The Token Service
# listens on 8102 inside the network; only its host port is remapped. The six
# gateways are published on loopback so their cards can be read with curl.
INTENT_AGENT_PORT=6003
INTENT_AGENT_HEALTH_PORT=8001
TOKEN_SERVICE_HOST_PORT=8302
TOKEN_SERVICE_BIND=127.0.0.1
IAG_BIND=127.0.0.1
IAG_TRADING_DESK_PORT=9901
IAG_SUPPORT_DESK_PORT=9902
IAG_BILLING_PORT=9903
IAG_PEOPLE_DIRECTORY_PORT=9904
IAG_WORKFLOW_RUNNER_PORT=9905
IAG_WEATHER_PORT=9906
